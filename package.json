{
  "name": "@weburz/carousel",
  "version": "0.4.0",
  "description": "Carousel components for Nuxt 4 — YouTube, Instagram, TikTok embeds with the platform lifecycle done right. Built on Embla.",
  "keywords": [
    "nuxt",
    "nuxt-module",
    "vue",
    "typescript",
    "carousel",
    "embla",
    "youtube",
    "instagram",
    "tiktok",
    "embed"
  ],
  "license": "MIT",
  "author": "Weburz",
  "homepage": "https://github.com/Weburz/carousel#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Weburz/carousel.git"
  },
  "bugs": {
    "url": "https://github.com/Weburz/carousel/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepack": "nuxt-module-build build",
    "check:dist": "node scripts/check-dist.mjs",
    "dev": "pnpm dev:prepare && nuxt dev playground",
    "dev:build": "nuxt build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxt prepare playground",
    "release": "pnpm lint && pnpm dev:prepare && pnpm test:types && pnpm test && pnpm prepack && pnpm check:dist && pnpm dev:build && changelogen --release && pnpm publish && git push --follow-tags",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:types": "vue-tsc --noEmit && cd playground && vue-tsc --noEmit",
    "setup:hooks": "pre-commit install && pre-commit install --hook-type commit-msg"
  },
  "dependencies": {
    "@nuxt/kit": "^4.4.8",
    "embla-carousel": "^8.6.0",
    "embla-carousel-vue": "^8.6.0"
  },
  "devDependencies": {
    "@nuxt/devtools": "^3.4.4",
    "@nuxt/eslint-config": "^1.17.0",
    "@nuxt/module-builder": "^1.0.3",
    "@nuxt/schema": "^4.6.2",
    "@nuxt/test-utils": "^4.3.4",
    "@types/node": "^26.6.5",
    "changelogen": "^0.6.2",
    "eslint": "^10.13.0",
    "happy-dom": "^21.0.4",
    "nuxt": "^4.6.2",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.13"
  },
  "publishConfig": {
    "access": "public"
  }
}
